{
  "name": "callmate-server",
  "version": "0.1.0",
  "private": true,
  "description": "CallMate backend: plans, places and summarizes phone calls on behalf of the user",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/formbody": "^9.0.2",
    "@fastify/websocket": "^11.3.7",
    "fastify": "^5.12.8",
    "twilio": "^6.3.1",
    "ws": "^8.23.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
