# Copy to .env and fill in. With nothing set, the server runs in simulation mode.

PORT=8787
# Use 0.0.0.0 to reach the server from a physical phone on the same Wi-Fi.
HOST=127.0.0.1

# Required when real calls are enabled. The app sends it as a Bearer token.
API_TOKEN=

# Only needed for the Flutter web build (e.g. http://127.0.0.1:8790). Mobile apps need none.
CORS_ORIGINS=

# auto: real calls when every Twilio + OpenAI value below is set, otherwise simulation.
CALL_PROVIDER=auto

# OpenAI: call planning/summaries (OPENAI_MODEL) and the live voice agent (OPENAI_REALTIME_MODEL).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# Twilio places the call and streams its audio to this server.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Public https URL that reaches this server (e.g. an ngrok or Cloudflare tunnel).
PUBLIC_BASE_URL=

# Safety limits
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_DAY=30
APPROVAL_TIMEOUT_SEC=90
MAX_CALL_DURATION_SEC=600
