# Copy to .env and fill in. With nothing set, the server runs in simulation mode.

PORT=8787
# Use 0.0.0.0 to reach the server from a physical phone on the same Wi-Fi.
HOST=127.0.0.1

# Required when real calls are enabled. The app sends it as a Bearer token.
API_TOKEN=

# Only needed for the Flutter web build (e.g. http://127.0.0.1:8790). Mobile apps need none.
CORS_ORIGINS=

# auto: real calls when every KAT Cloud + OpenAI value below is set, otherwise simulation.
CALL_PROVIDER=auto

# OpenAI: call planning/summaries (OPENAI_MODEL) and the live voice agent (OPENAI_REALTIME_MODEL).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin

# KAT Cloud (https://katcloud.kr) places the call and streams G.711 audio to this server.
# Create an API key in the console; GET /group for groupId; GET /webhook/secret for the secret.
KAT_API_KEY=
KAT_GROUP_ID=
KAT_FROM_NUMBER=
KAT_WEBHOOK_SECRET=
# Optional override (default: https://studio-gateway.zerocall.kr)
# KAT_API_BASE_URL=https://studio-gateway.zerocall.kr

# Public https URL that reaches this server (e.g. Cloudflare Tunnel). Must be reachable from Korea.
PUBLIC_BASE_URL=

# Safety limits
MAX_CONCURRENT_CALLS=2
MAX_CALLS_PER_DAY=30
APPROVAL_TIMEOUT_SEC=90
MAX_CALL_DURATION_SEC=600
